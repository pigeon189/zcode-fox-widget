# 运行时与开发过程中的产物，不应入库
.mimosa/
node_modules/
*.log

# 本机数据目录（配置、账本、Electron 运行时）不在这里，但以防有人拷贝进来
desktop-runtime/

# 宿主 agent 在本目录工作时留下的本地状态（WorkBuddy 的项目记忆、ZCode 的临时产物）
.workbuddy/
.zcode/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# 视觉测试产物（基线入库，实拍与差异图不入库）
dock/test/visual/__shots__/
dock/test/visual/__diff__/
dock/test/playwright-report/
dock/test/test-results/
