# 运行时与开发过程中的产物，不应入库
.mimosa/
node_modules/
*.log

# 市场分发包（node tools/build-marketplace.mjs 生成，可随时重建）
dist/

# 宿主 AI 的工作记忆目录（会话状态，不是项目资料）
.workbuddy/

# 本机数据目录（配置、账本、Electron 运行时）不在这里，但以防有人拷贝进来
desktop-runtime/

# README 插图的本地渲染预览（由 docs/readme/*.svg 生成，不入库）
docs/readme/previews/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
