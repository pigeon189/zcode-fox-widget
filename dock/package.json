{
  "name": "fox-dock",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Universal desktop pet for agent cost visibility: ZCode / WorkBuddy / Kimi Code / DeepSeek Harness",
  "scripts": {
    "test": "node tools/run-tests.mjs --suite unit",
    "test:it": "node tools/run-tests.mjs --suite integration",
    "test:all": "node tools/run-tests.mjs --suite all",
    "doctor": "node tools/fox-dock.mjs doctor",
    "check": "node tools/check-syntax.mjs",
    "lint": "node tools/lint.mjs",
    "ci": "npm run check && npm run check:sync && npm test && npm run lint",
    "shots": "node tools/shots.mjs",
    "fixture": "node tools/fixture-daemon.mjs",
    "start": "node tools/fox-dock.mjs start",
    "stop": "node tools/fox-dock.mjs stop",
    "status": "node tools/fox-dock.mjs status",
    "install-app": "node tools/fox-dock.mjs install",
    "verify:zcode": "node tools/verify-zcode.mjs",
    "verify:workbuddy": "node tools/verify-workbuddy.mjs",
    "check:sync": "node tools/check-pricing-sync.mjs",
    "e2e:real": "node tools/e2e-real.mjs",
    "soak": "node tools/soak.mjs",
    "keygen": "node tools/dock-keygen.mjs",
    "sign": "node tools/sign-manifest.mjs",
    "pack": "node tools/pack-release.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "foxDock": {
    "electron": "44.4.5"
  }
}
