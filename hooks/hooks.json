{
  "description": "WorkBuddy狐娘小挂件：会话启动时幂等拉起本地挂件服务（对应上游「每次打开界面自动启用」）。可在 ${CODEBUDDY_PLUGIN_DATA}/config.json 里把 autoStartWidget 设为 false 关闭自启。另挂两个**低频**事件把「开始干活 / 在等你确认」写给挂件（见 lib/hook-event.mjs 里的取舍说明）。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/lib/autostart.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/lib/hook-event.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/lib/hook-event.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
